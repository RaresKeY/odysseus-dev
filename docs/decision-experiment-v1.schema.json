{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:odysseus:decision-experiment:v1",
  "title": "Odysseus offline decision experiment report",
  "type": "object",
  "required": ["schema", "mode", "evidence_kind", "fixture_version", "fixture_sha256", "label_provenance", "decision_schema", "source_hashes", "policy_versions", "thresholds", "provider", "runtime", "totals", "confusion_matrices", "cases", "usage", "latency", "downstream_task_success", "limitations"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "odysseus-decision-experiment/v1"},
    "mode": {"const": "offline_contract_replay"},
    "evidence_kind": {"const": "authored_synthetic_fixture"},
    "fixture_version": {"type": "string", "minLength": 1},
    "fixture_sha256": {"$ref": "#/$defs/hash"},
    "label_provenance": {"type": "string"},
    "decision_schema": {"const": "odysseus-decision/v1"},
    "source_hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/hash"}},
    "policy_versions": {"type": "object", "required": ["approval", "approach", "browser"], "additionalProperties": {"type": "string"}},
    "thresholds": {"type": "object", "required": ["approval", "approach", "browser"], "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}},
    "provider": {"type": "object", "required": ["model", "protocol", "distribution_source"]},
    "runtime": {"type": "object", "required": ["python", "concurrency", "order", "inference", "network"], "properties": {"inference": {"const": false}, "network": {"const": false}}},
    "totals": {"type": "object", "required": ["attempted", "valid", "invalid", "unresolved", "uncertain", "unsafe_allows", "safety_cases", "safety_negative_cases"], "additionalProperties": {"type": "integer", "minimum": 0}},
    "confusion_matrices": {"type": "object"},
    "cases": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["fixture_id", "source_group", "purpose", "request_sha256", "response_sha256", "status", "expected_choice", "choice", "label_agreement", "uncertain", "unsafe_allow", "failure_kind", "attempts", "usage", "usage_source", "retained_reservation", "task_success", "task_success_reason"], "properties": {
      "fixture_id": {"type": "string"}, "source_group": {"type": "string"},
      "purpose": {"enum": ["approval", "approach", "browser"]},
      "request_sha256": {"$ref": "#/$defs/hash"}, "response_sha256": {"$ref": "#/$defs/hash"},
      "status": {"enum": ["valid", "invalid", "unresolved"]},
      "label_agreement": {"type": "boolean"}, "uncertain": {"type": "boolean"}, "unsafe_allow": {"type": "boolean"},
      "attempts": {"type": "integer", "minimum": 0, "maximum": 1},
      "usage_source": {"enum": ["authored_fixture", "unknown"]},
      "task_success": {"type": "null"}, "task_success_reason": {"type": "string"}
    }}},
    "usage": {"type": "object", "required": ["live_calls", "actual_provider_tokens", "actual_provider_tokens_reason", "unknown_fixture_attempts"], "properties": {"live_calls": {"const": 0}, "actual_provider_tokens": {"type": "null"}}},
    "latency": {"type": "object", "required": ["median_ms", "p95_ms", "reason"], "properties": {"median_ms": {"type": "null"}, "p95_ms": {"type": "null"}, "reason": {"type": "string"}}},
    "downstream_task_success": {"type": "null"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
